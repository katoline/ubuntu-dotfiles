{
    "workbench.iconTheme": "material-icon-theme",
    "github.copilot.nextEditSuggestions.enabled": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "terminal.integrated.fontFamily": "UbuntuMono Nerd Font Mono",
    // VS Code 1.109+ は Kitty Keyboard Protocol が既定ON。xterm.js が
    // press と release を二重に送り、Claude Code などの TUI で
    // 1キーが2文字入る。従来のキー符号化に戻す。
    "terminal.integrated.enableKittyKeyboardProtocol": false,
    // Claude Code などは入力のたびに画面を打ち直す TUI。local echo
    // （入力先読み）が Mozc の変換中プレビューをバッファへ焼き込み、
    // 確定文字と混ざって「ｋこｎこのこの」になる。
    "terminal.integrated.localEchoEnabled": "off",
    // Alt+H/J/K/L をカーソル移動に使うため、メニューニーモニック
    //（Alt+H = ヘルプ等）と Alt 単体でのメニューフォーカスを無効化
    "window.enableMenuBarMnemonics": false,
    "window.customMenuBarAltFocus": false,
    // Linux の既定は custom タイトルバーで、閉じる/最小化/最大化が
    // 右上固定になる。GNOME（desktop.nix の button-layout）と同じ
    // macOS 風の左上配置にするため、OS ネイティブのタイトルバーを使う。
    // native のままだとメニューがタイトルバー直下の二段目になり縦を食う。
    // compact は titleBarStyle=native かつ menuStyle が native/inherit だと
    // 無視されるので、custom にしてサイドバーのハンバーガーへ移す。
    // 反映には VS Code / Cursor の再起動が必要。
    "window.titleBarStyle": "native",
    "window.menuStyle": "custom",
    "window.menuBarVisibility": "compact",
    // 統合ターミナルのホイールを既定（1）より速くする
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    // AMD + Wayland で統合ターミナルの描画が欠ける／ちらつくため GPU
    // アクセラレーションを切る。auto に戻すと再発しうる
    "terminal.integrated.gpuAcceleration": "off",
    "claudeCode.preferredLocation": "panel"
}
