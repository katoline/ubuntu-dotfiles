// 既定値を上書きするには、このファイル内にキー バインドを挿入します
// Vim風移動（Alt+H/J/K/L = 左/下/上/右）。エディタ／入力欄のみ。
// textInputFocus は統合ターミナルの隠しtextareaでも真になるため、
// !terminalFocus を付けて TUI へキーを渡す。
// Linux のメニューニーモニック（Alt+H = ヘルプ等）は settings.json で無効化。
[
    {
        "key": "alt+h",
        "command": "cursorLeft",
        "when": "textInputFocus && !terminalFocus"
    },
    {
        "key": "alt+j",
        "command": "cursorDown",
        "when": "textInputFocus && !terminalFocus"
    },
    {
        "key": "alt+k",
        "command": "cursorUp",
        "when": "textInputFocus && !terminalFocus"
    },
    {
        "key": "alt+l",
        "command": "cursorRight",
        "when": "textInputFocus && !terminalFocus"
    },
    {
        "key": "alt+shift+h",
        "command": "cursorLeftSelect",
        "when": "textInputFocus && !terminalFocus"
    },
    {
        "key": "alt+shift+j",
        "command": "cursorDownSelect",
        "when": "textInputFocus && !terminalFocus"
    },
    {
        "key": "alt+shift+k",
        "command": "cursorUpSelect",
        "when": "textInputFocus && !terminalFocus"
    },
    {
        "key": "alt+shift+l",
        "command": "cursorRightSelect",
        "when": "textInputFocus && !terminalFocus"
    },
    // Linuxの統合ターミナル既定は Ctrl+Shift+C/V。他アプリと揃え Ctrl+C/V にする。
    // Ctrl+C は選択中だけコピーし、未選択時はシェルへ渡して SIGINT を維持する。
    // 選択中は Ctrl+C がコピーに取られるので、コマンドキャンセルは Ctrl+Shift+C で SIGINT を送る
    {
        "key": "ctrl+c",
        "command": "workbench.action.terminal.copySelection",
        "when": "terminalFocus && terminalTextSelected"
    },
    {
        "key": "ctrl+v",
        "command": "workbench.action.terminal.paste",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+shift+c",
        "command": "-workbench.action.terminal.copySelection"
    },
    {
        "key": "ctrl+shift+c",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u0003"
        },
        "when": "terminalFocus"
    },
    // Claude Code などの TUI は Enter が送信、Shift+Enter が改行。
    // 統合ターミナル既定はどちらも CR だけなので、Shift+Enter を
    // ESC+CR に差し替え、TUI 側の改行として届ける
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001b\r"
        },
        "when": "terminalFocus"
    }
]
